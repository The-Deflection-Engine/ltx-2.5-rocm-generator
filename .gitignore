# Ignore everything by default
/*
.*

# Whitelist root files
!.gitignore
!generate_video.py
!quant_transformer_fp8.py
!cli_gen_vid.py
!ltx_engine.py
!bench_vae_tiles.py
!CLAUDE.md

# Test harness lives in its own directory; /* only matches root entries, so
# un-ignoring the directory is enough to include what is inside it.
!tests/
tests/__pycache__/

# Prompt + screenshot + video examples, same reasoning as tests/ above.
!Examples/
!Prompting Guide/
# Real prompts/results from ad-hoc A/B sessions -- tests/variants.example.json
# is the committed template, everything else here is scratch.
tests/variants.*.json
!tests/variants.example.json
# A/B render harness output: multi-hundred-MB video files, per-run scratch.
runs/
!README.md
!requirements.txt
# ltx2_config.json is deliberately NOT tracked: the GUI rewrites it on every
# Generate, so it holds live working state (prompt, seed, local absolute image
# paths) rather than anything shareable. Ship the documented defaults instead;
# generate_video.py falls back to its in-code defaults when the file is absent.
!ltx2_config.example.json

# Un-ignore the directory container, ignore its contents, but allow model_index.json + README
!local_ltx25_model/
local_ltx25_model/*
!local_ltx25_model/model_index.json
!local_ltx25_model/README.md
.embed_cache/
